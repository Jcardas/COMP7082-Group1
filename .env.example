# ==============================================================
# SERVER CONFIGURATION
# Note: Defaulted to 5001 to prevent conflicts with macOS AirPlay (port 5000)
# ==============================================================
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ==============================================================
# SUPABASE & PGVECTOR CONFIGURATION
# Sign up / Login: https://supabase.com
# Create a new project, go to Project Settings -> API
# ==============================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================
# HUGGING FACE INFERENCE API
# Sign up / Login: https://huggingface.co
# Get Access Token (Read): https://huggingface.co/settings/tokens
# Used for generating mod descriptions embeddings & NLP search queries
# ==============================================================
HUGGINGFACE_API_KEY=hf_your_huggingface_access_token
# Default recommended embedding model: 384 dimensions
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==============================================================
# CURSEFORGE API
# Register / Login: https://console.curseforge.com
# Create an application to get your x-api-key
# ==============================================================
CURSEFORGE_API_KEY=$2a$10$your_curseforge_api_key

# ==============================================================
# MODRINTH API
# Docs: https://docs.modrinth.com/api-spec/
# Modrinth requires a descriptive User-Agent header (email/contact or app name)
# Optional PAT: https://modrinth.com/settings/pats
# ==============================================================
MODRINTH_USER_AGENT=COMP7082-Group1-ModpackMaker/0.1.0 (contact@yourteam.com)
MODRINTH_API_TOKEN=optional_modrinth_personal_access_token

# ==============================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite prefixes with VITE_)
# ==============================================================
VITE_SERVER_URL=http://localhost:5001
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
